        // Fonction pour naviguer vers un témoignage spécifique
        function goToTestimonial(index) {
            const slider = document.getElementById('testimonialsSlider');
            const dots = document.querySelectorAll('.slider-dot');
            
            // Mettre à jour la position du slider
            slider.style.transform = `translateX(-${index * 100}%)`;
            
            // Mettre à jour les points actifs
            dots.forEach((dot, i) => {
                if (i === index) {
                    dot.classList.add('active');
                } else {
                    dot.classList.remove('active');
                }
            });
        }

        // Variables pour le carrousel de témoignages
        let currentTestimonial = 0;
        const testimonialInterval = 5000; // 5 secondes

        // Fonction pour faire défiler automatiquement les témoignages
        function autoScrollTestimonials() {
            currentTestimonial = (currentTestimonial + 1) % testimonials.length;
            goToTestimonial(currentTestimonial);
        }

        // Initialiser toutes les sections
        document.addEventListener('DOMContentLoaded', function() {
            initTestimonials();
            initCourses();
            initTeachers();
            initSchools();
            initPartners();
            
            // Démarrer le défilement automatique des témoignages
            setInterval(autoScrollTestimonials, testimonialInterval);
            
            // Ajouter un effet de défilement doux pour les ancres
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    const targetId = this.getAttribute('href');
                    if (targetId === '#') return;
                    
                    const targetElement = document.querySelector(targetId);
                    if (targetElement) {
                        window.scrollTo({
                            top: targetElement.offsetTop - 80,
                            behavior: 'smooth'
                        });
                    }
                });
            });
        });
