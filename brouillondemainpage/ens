        searchBtn.addEventListener('click', performSearch);

        mainSearchInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                performSearch();
            }
        });

        function performSearch() {
            const searchType = document.getElementById('searchType').value;
            const searchLevel = document.getElementById('searchLevel').value;
            const searchSubject = document.getElementById('searchSubject').value;
            const searchServiceType = document.getElementById('searchServiceType').value;
            const searchStatus = document.getElementById('searchStatus').value;
            const searchDate = document.getElementById('searchDate').value;
            const searchQuery = mainSearchInput.value.trim();
            
            searchFiltersPanel.classList.remove('active');
            showSearchResults({
                query: searchQuery,
                type: searchType,
                level: searchLevel,
                subject: searchSubject,
                serviceType: searchServiceType,
                status: searchStatus,
                date: searchDate
            });
        }

        function showSearchResults(filters) {
            alert(`Recherche avec les filtres:\n
                Type: ${filters.type}\n
                Niveau: ${filters.level}\n
                Matière: ${filters.subject}\n
                Type de service: ${filters.serviceType}\n
                Statut: ${filters.status}\n
                Date: ${filters.date}\n
                Recherche: "${filters.query}"`);
        }

        // Gestion de la flèche retour en haut
        function toggleBackToTopButton() {
            const scrollPosition = window.scrollY;
            const windowHeight = window.innerHeight;
            const documentHeight = document.documentElement.scrollHeight;
            
            // Calcul du pourcentage de défilement
            const scrollPercent = (scrollPosition / (documentHeight - windowHeight)) * 100;
            
            // Mettre à jour l'indicateur de progression
            const circleLength = 113.097; // 2 * π * r (r=18)
            const offset = circleLength - (scrollPercent / 100) * circleLength;
            scrollProgressCircle.style.strokeDashoffset = offset;
            scrollProgressText.textContent = Math.round(scrollPercent) + '%';
            
            // Afficher/masquer les boutons
            if (scrollPosition > 300) {
                backToTopBtn.classList.add('visible');
                scrollProgress.classList.add('visible');
            } else {
                backToTopBtn.classList.remove('visible');
                scrollProgress.classList.remove('visible');
            }
        }

        function scrollToTop() {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        }

        // Gestion de la touche Escape
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                scrollToTop();
            }
        });

        // Initialisation des données (simulation)
        document.addEventListener('DOMContentLoaded', function() {
            // Mettre à jour les statistiques avec les données simulées
            const statElements = document.querySelectorAll('.stat-info h3');
            if (statElements.length >= 4) {
                statElements[0].innerText = teacherData.services.length;
                statElements[1].innerText = teacherData.totalStudents;
                statElements[2].innerText = teacherData.avgRating + '/5';
                statElements[3].innerText = teacherData.monthlyRevenue;
            }
            
            // Remplir les options du formulaire
            const subjectSelect = document.getElementById('serviceSubject');
            teacherData.subjects.forEach(subject => {
                const option = document.createElement('option');
                option.value = subject.toLowerCase().replace(' ', '_');
                option.textContent = subject;
                subjectSelect.appendChild(option);
            });
            
            const levelSelect = document.getElementById('serviceLevel');
            teacherData.levels.forEach(level => {
                const option = document.createElement('option');
                option.value = level.replace('ème', 'eme');
                option.textContent = level;
                levelSelect.appendChild(option);
            });
            
            // Initialiser les notifications
            initNotifications();
            updateNotificationBadge();
            
            // Événements pour la flèche retour en haut
            window.addEventListener('scroll', toggleBackToTopButton);
            backToTopBtn.addEventListener('click', scrollToTop);
            
            // Initialiser la visibilité des boutons
            toggleBackToTopButton();
            
            // Gestion responsive
            function checkWindowSize() {
                if (window.innerWidth <= 992) {
                    if (document.querySelector('.menu-toggle')) {
                        document.querySelector('.menu-toggle').style.display = 'block';
                    }
                } else {
                    if (document.querySelector('.menu-toggle')) {
                        document.querySelector('.menu-toggle').style.display = 'none';
                    }
                    if (mobileNav) mobileNav.classList.remove('active');
                }
            }
            
            window.addEventListener('resize', checkWindowSize);
            checkWindowSize();
            
            // Empêcher la propagation sur tous les boutons d'actions
            document.querySelectorAll('.service-card-actions').forEach(actions => {
                actions.addEventListener('click', (e) => {
                    e.stopPropagation();
                });
            });
        });
