            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 30px;
            margin-bottom: 40px;
        }

        .dashboard-section {
            background-color: var(--blanc-principal);
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            transition: transform 0.3s;
        }

        .dashboard-section:hover {
            transform: translateY(-5px);
        }

        .section-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 20px;
            color: var(--blanc-principal);
        }

        .section-icon.students {
            background: linear-gradient(45deg, var(--vert-principal), var(--bleu-prof));
        }

        .section-icon.contracts {
            background: linear-gradient(45deg, var(--jaune-principal), var(--rouge-principal));
        }

        .section-icon.calendar {
            background: linear-gradient(45deg, var(--violet-premium), var(--cyan-suggestion));
        }

        .dashboard-section h3 {
            font-size: 1.3rem;
            color: var(--gris-fonce);
            margin-bottom: 10px;
        }

        .dashboard-section p {
            color: var(--gris-moyen);
            margin-bottom: 20px;
            font-size: 0.95rem;
        }

        .section-stats {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid var(--gris-clair);
        }

        .stat-item {
            text-align: center;
        }

        .stat-number {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--gris-fonce);
            display: block;
        }

        .stat-label {
            font-size: 0.85rem;
            color: var(--gris-moyen);
        }

        /* Modal création de service */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.5);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }

        .modal {
            background-color: var(--blanc-principal);
            border-radius: 15px;
            width: 90%;
            max-width: 800px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 50px rgba(0,0,0,0.2);
        }

        .modal-header {
            padding: 25px 30px;
            border-bottom: 1px solid var(--gris-clair);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-title {
            font-size: 1.5rem;
            color: var(--gris-fonce);
        }

        .modal-close {
            background: none;
            border: none;
            font-size: 1.5rem;
            color: var(--gris-moyen);
            cursor: pointer;
            transition: color 0.3s;
        }

        .modal-close:hover {
            color: var(--rouge-principal);
        }

        .modal-body {
            padding: 30px;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: var(--gris-fonce);
        }

        .form-control {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid var(--gris-clair);
            border-radius: 8px;
            font-size: 1rem;
            transition: border-color 0.3s;
            background-color: var(--blanc-principal);
        }

        .form-control:focus {
            outline: none;
            border-color: var(--jaune-principal);
            box-shadow: 0 0 0 3px rgba(255,215,0,0.1);
        }

        .form-text {
            font-size: 0.85rem;
            color: var(--gris-moyen);
            margin-top: 5px;
        }

        /* Plans de tarification - MODIFIÉ */
        .pricing-plans {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin: 30px 0;
        }

        .plan-option {
            border: 2px solid var(--gris-clair);
            border-radius: 10px;
            padding: 25px;
            cursor: pointer;
            transition: all 0.3s;
            text-align: center;
        }

        .plan-option.selected {
            border-color: var(--jaune-principal);
            background-color: rgba(255,215,0,0.05);
        }

        .plan-option:hover {
            border-color: var(--jaune-principal);
        }

        .plan-name {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .plan-price {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .plan-price.free {
            color: var(--vert-principal);
        }

        .plan-price.standard {
            color: var(--bleu-prof);
        }

        .plan-price.premium {
            color: var(--violet-premium);
        }

        .plan-price-note {
            font-size: 0.85rem;
            color: var(--gris-moyen);
            margin-bottom: 15px;
            font-style: italic;
        }

        .plan-features {
            text-align: left;
            margin-bottom: 20px;
        }

        .plan-features li {
            margin-bottom: 10px;
            padding-left: 25px;
            position: relative;
        }

        .plan-features li:before {
            content: "✓";
            position: absolute;
            left: 0;
            color: var(--vert-principal);
            font-weight: bold;
        }

        .plan-features li.disabled:before {
            content: "✗";
            color: var(--gris-moyen);
        }

        /* Footer */
        .main-footer {
            background-color: var(--gris-fonce);
            color: var(--gris-clair);
            padding: 60px 0 30px;
            margin-top: 60px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-col h3 {
            color: var(--blanc-principal);
            font-size: 1.3rem;
            margin-bottom: 20px;
            position: relative;
            padding-bottom: 10px;
        }

        .footer-col h3:after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 50px;
            height: 2px;
            background-color: var(--jaune-principal);
        }

        .footer-links {
            list-style: none;
        }

        .footer-links li {
            margin-bottom: 12px;
        }

        .footer-links a {
            color: var(--gris-clair);
            text-decoration: none;
            transition: color 0.3s;
        }

        .footer-links a:hover {
            color: var(--jaune-principal);
        }

        .social-links {
            display: flex;
            gap: 15px;
            margin-top: 20px;
        }

        .social-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: rgba(255,255,255,0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--blanc-principal);
            text-decoration: none;
            transition: all 0.3s;
        }

        .social-icon:hover {
            background-color: var(--jaune-principal);
            color: var(--gris-fonce);
            transform: translateY(-3px);
        }

        .copyright {
            text-align: center;
            padding-top: 30px;
            border-top: 1px solid rgba(255,255,255,0.1);
            font-size: 0.9rem;
            color: var(--gris-clair);
        }

        /* Menu mobile toggle */
        .menu-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: var(--gris-fonce);
            cursor: pointer;
        }

        /* Menu Mobile */
        .mobile-nav {
            display: none;
            position: fixed;
            top: 80px;
            left: 0;
            width: 100%;
            background: linear-gradient(90deg, var(--vert-principal) 0%, var(--jaune-principal) 33%, var(--rouge-principal) 66%, var(--blanc-principal) 100%);
            z-index: 1000;
            box-shadow: 0 5px 10px rgba(0,0,0,0.1);
        }

        .mobile-nav.active {
            display: block;
        }

        .mobile-menu {
            display: flex;
            flex-direction: column;
            padding: 15px;
        }

        .mobile-nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 15px;
            color: var(--blanc-principal);
            text-decoration: none;
            border-bottom: 1px solid rgba(255,255,255,0.2);
        }

        .mobile-nav-item:last-child {
            border-bottom: none;
        }

        .mobile-nav-item.active {
            background-color: rgba(255,255,255,0.2);
            font-weight: 600;
        }

        .mobile-nav-badge {
            margin-left: auto;
            background-color: var(--rouge-principal);
            color: var(--blanc-principal);
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 0.75rem;
        }

        /* Modals */
        .notification-modal {
            max-width: 500px;
        }

        .notification-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            border-bottom: 1px solid var(--gris-clair);
        }

        .notification-title {
            font-size: 1.3rem;
            font-weight: 600;
        }

        .notification-actions {
            display: flex;
            gap: 10px;
        }

        .mark-all-read {
            background: none;
            border: none;
            color: var(--bleu-prof);
            cursor: pointer;
            font-weight: 500;
            font-size: 0.9rem;
        }

        .notification-list {
            max-height: 400px;
            overflow-y: auto;
        }

        .notification-item {
            padding: 15px 20px;
            border-bottom: 1px solid var(--gris-clair);
            transition: background-color 0.3s;
            cursor: pointer;
        }

        .notification-item:hover {
            background-color: var(--gris-clair);
        }

        .notification-item.unread {
            background-color: rgba(33,150,243,0.05);
        }

        .notification-content {
            display: flex;
            align-items: flex-start;
            gap: 15px;
        }

        .notification-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }

        .notification-icon.success {
            background-color: rgba(76,175,80,0.1);
            color: var(--vert-principal);
        }

        .notification-icon.warning {
            background-color: rgba(255,193,7,0.1);
            color: var(--jaune-principal);
        }

        .notification-icon.info {
            background-color: rgba(33,150,243,0.1);
            color: var(--bleu-prof);
        }

        .notification-icon.alert {
            background-color: rgba(244,67,54,0.1);
            color: var(--rouge-principal);
        }

        .notification-text h4 {
            font-size: 0.95rem;
            margin-bottom: 5px;
            color: var(--gris-fonce);
        }

        .notification-text p {
            font-size: 0.85rem;
            color: var(--gris-moyen);
            margin-bottom: 5px;
        }

        .notification-time {
            font-size: 0.75rem;
            color: var(--gris-moyen);
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .services-grid {
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            }
            
            .pricing-plans {
                grid-template-columns: 1fr;
                gap: 15px;
            }
            
            .horizontal-menu {
                gap: 2px;
            }
            
            .nav-item {
                padding: 10px 15px;
                font-size: 0.9rem;
            }
        }

        @media (max-width: 992px) {
            .horizontal-nav {
                display: none;
            }
            
            .menu-toggle {
                display: block;
            }
            
            .mobile-nav {
                display: none;
                position: fixed;
                top: 80px;
                left: 0;
                width: 100%;
                background: linear-gradient(90deg, var(--vert-principal) 0%, var(--jaune-principal) 33%, var(--rouge-principal) 66%, var(--blanc-principal) 100%);
                z-index: 1000;
                box-shadow: 0 5px 10px rgba(0,0,0,0.1);
            }
            
            .mobile-nav.active {
                display: block;
            }
            
            .mobile-menu {
                display: flex;
                flex-direction: column;
                padding: 15px;
            }
            
            .mobile-nav-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 12px 15px;
                color: var(--blanc-principal);
                text-decoration: none;
                border-bottom: 1px solid rgba(255,255,255,0.2);
            }
            
            .mobile-nav-item:last-child {
                border-bottom: none;
            }
            
            .mobile-nav-item.active {
                background-color: rgba(255,255,255,0.2);
                font-weight: 600;
            }
            
            .mobile-nav-badge {
                margin-left: auto;
                background-color: var(--rouge-principal);
                color: var(--blanc-principal);
                padding: 2px 8px;
                border-radius: 10px;
                font-size: 0.75rem;
            }
        }

        @media (max-width: 768px) {
            .dashboard-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }
            
            .services-grid {
                grid-template-columns: 1fr;
            }
            
            .stats-grid {
                grid-template-columns: 1fr;
            }
            
            .header-actions {
                width: 100%;
                justify-content: space-between;
            }
            
            .teacher-quick-info {
                flex-direction: column;
                text-align: center;
                gap: 5px;
            }
            
            .main-content {
                padding: 20px 0 30px;
            }
            
            .dashboard-sections {
                grid-template-columns: 1fr;
            }
            
            .search-bar-container {
                order: 3;
                max-width: 100%;
                margin-top: 15px;
            }
        }

        @media (max-width: 480px) {
            .container {
                padding: 0 10px;
            }
            
            .services-section {
                padding: 20px;
            }
            
            .modal-body {
                padding: 20px;
            }
            
            .modal-header {
                padding: 20px;
            }
            
            .service-card-actions {
                flex-direction: column;
            }
            
            .btn-service-action {
                width: 100%;
            }
        }
    </style>
</head>
