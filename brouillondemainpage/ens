        document.addEventListener('click', (e) => {
            if (!searchFiltersPanel.contains(e.target) && 
                !searchFiltersBtn.contains(e.target) && 
                searchFiltersPanel.classList.contains('active')) {
                searchFiltersPanel.classList.remove('active');
            }
        });

