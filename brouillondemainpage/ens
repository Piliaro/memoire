        // Gestion du modal
        const createServiceBtn = document.getElementById('createServiceBtn');
        const createServiceBtnMobile = document.getElementById('createServiceBtnMobile');
        const createServiceModal = document.getElementById('createServiceModal');
        const closeModalBtn = document.getElementById('closeModalBtn');
        const cancelServiceBtn = document.getElementById('cancelServiceBtn');
        const planOptions = document.querySelectorAll('.plan-option');
        const selectedPlanInput = document.getElementById('selectedPlan');
        const hourlyRateInput = document.getElementById('hourlyRate');
        const hourlyRateGroup = document.getElementById('hourlyRateGroup');
        const rateInfo = document.getElementById('rateInfo');
        
        // Gestion menu mobile
        const mobileNavToggle = document.getElementById('mobileNavToggle');
        const mobileNav = document.getElementById('mobileNav');
        
        // Filtres des services
        const filterBtns = document.querySelectorAll('.filter-btn');
        const serviceCards = document.querySelectorAll('.service-card[data-plan]');
        
        // Gestion notifications
        const notificationBtn = document.getElementById('notificationBtn');
        const notificationModal = document.getElementById('notificationModal');
        const closeNotificationModalBtn = document.getElementById('closeNotificationModalBtn');
        const markAllReadBtn = document.getElementById('markAllReadBtn');
        const notificationNavBtnMobile = document.getElementById('notificationNavBtnMobile');
        
        // Gestion profil
        const profileBtn = document.getElementById('profileBtn');
        const profileMenu = document.getElementById('profileMenu');

        // Gestion barre de recherche
        const searchFiltersBtn = document.getElementById('searchFiltersBtn');
        const searchFiltersPanel = document.getElementById('searchFiltersPanel');
        const closeFiltersBtn = document.getElementById('closeFiltersBtn');
        const resetFiltersBtn = document.getElementById('resetFiltersBtn');
        const applyFiltersBtn = document.getElementById('applyFiltersBtn');
        const searchBtn = document.getElementById('searchBtn');
        const mainSearchInput = document.getElementById('mainSearchInput');

        // Flèche retour en haut
        const backToTopBtn = document.getElementById('backToTopBtn');
        const scrollProgress = document.getElementById('scrollProgress');
        const scrollProgressCircle = document.querySelector('.scroll-progress-circle');
        const scrollProgressText = document.querySelector('.scroll-progress-text');

        // Fonction pour voir les détails d'un service
        function viewServiceDetails(serviceId) {
            alert(`Voir les détails du service #${serviceId}`);
            // Redirection vers la page de détails
            // window.location.href = `service_details.html?id=${serviceId}`;
        }

        // Fonction pour modifier un service
        function editService(serviceId) {
            event.stopPropagation();
            alert(`Modification du service #${serviceId}`);
            // Redirection vers la page d'édition
            // window.location.href = `edit_service.html?id=${serviceId}`;
        }

        // Fonction pour supprimer un service
        function deleteService(serviceId) {
            event.stopPropagation();
            if (confirm("Êtes-vous sûr de vouloir supprimer ce service ? Cette action est irréversible.")) {
                alert(`Service #${serviceId} supprimé`);
                // Code pour supprimer le service
                // window.location.reload(); // Recharger la page après suppression
            }
        }

        // Empêcher la propagation du clic depuis les boutons
        document.querySelectorAll('.service-card-actions button').forEach(button => {
            button.addEventListener('click', (e) => {
                e.stopPropagation();
            });
        });

        // Ouvrir modal création service
        createServiceBtn.addEventListener('click', openServiceModal);
        if (createServiceBtnMobile) {
            createServiceBtnMobile.addEventListener('click', openServiceModal);
        }

        function openServiceModal() {
            createServiceModal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
            // Fermer menu mobile si ouvert
            if (mobileNav) mobileNav.classList.remove('active');
        }

        // Fermer modal création service
        closeModalBtn.addEventListener('click', closeServiceModal);
        cancelServiceBtn.addEventListener('click', closeServiceModal);
        createServiceModal.addEventListener('click', (e) => {
            if (e.target === createServiceModal) {
                closeServiceModal();
            }
        });

        function closeServiceModal() {
            createServiceModal.style.display = 'none';
            document.body.style.overflow = 'auto';
            // Réinitialiser le formulaire
            document.getElementById('createServiceForm').reset();
            planOptions.forEach(opt => opt.classList.remove('selected'));
            selectedPlanInput.value = '';
            hourlyRateInput.value = '';
            hourlyRateInput.required = false;
            hourlyRateGroup.style.display = 'block';
            rateInfo.textContent = "Veuillez fixer un tarif raisonnable pour votre service";
        }

        // Ouvrir modal notifications
        notificationBtn.addEventListener('click', openNotificationModal);
        if (notificationNavBtnMobile) {
            notificationNavBtnMobile.addEventListener('click', () => {
                openNotificationModal();
                if (mobileNav) mobileNav.classList.remove('active');
            });
        }

        function openNotificationModal() {
            notificationModal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
            initNotifications();
        }

        // Fermer modal notifications
        closeNotificationModalBtn.addEventListener('click', closeNotificationModal);
        notificationModal.addEventListener('click', (e) => {
            if (e.target === notificationModal) {
                closeNotificationModal();
            }
        });

        function closeNotificationModal() {
            notificationModal.style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        // Gestion menu mobile
        if (mobileNavToggle) {
            mobileNavToggle.addEventListener('click', () => {
                if (mobileNav) mobileNav.classList.toggle('active');
            });
        }

        // Fermer menu mobile en cliquant à l'extérieur
        document.addEventListener('click', (e) => {
            if (mobileNav && !mobileNav.contains(e.target) && mobileNavToggle && !mobileNavToggle.contains(e.target)) {
                mobileNav.classList.remove('active');
            }
        });

        // Gestion menu déroulant profil
        profileBtn.addEventListener('click', () => {
            profileMenu.classList.toggle('active');
        });

        // Fermer le menu déroulant en cliquant à l'extérieur
        document.addEventListener('click', (e) => {
            if (!profileBtn.contains(e.target) && !profileMenu.contains(e.target)) {
                profileMenu.classList.remove('active');
            }
        });

        // Sélection du plan
        planOptions.forEach(option => {
            option.addEventListener('click', () => {
                // Retirer la sélection précédente
                planOptions.forEach(opt => opt.classList.remove('selected'));
                
                // Ajouter la sélection
                option.classList.add('selected');
                
                // Mettre à jour le champ caché
                const planType = option.dataset.plan;
                selectedPlanInput.value = planType;
                
                // Mettre à jour le tarif selon le plan
                updatePricing(planType);
            });
        });

        function updatePricing(planType) {
            switch(planType) {
                case 'gratuit':
                    hourlyRateInput.value = 0;
                    hourlyRateInput.disabled = true;
                    hourlyRateInput.required = false;
                    hourlyRateGroup.style.display = 'block';
                    rateInfo.textContent = "Service gratuit pour attirer les premiers élèves";
                    break;
                case 'standard':
                    hourlyRateInput.value = '';
                    hourlyRateInput.disabled = false;
                    hourlyRateInput.required = true;
                    hourlyRateGroup.style.display = 'block';
                    hourlyRateInput.placeholder = "Ex: 2500";
                    rateInfo.textContent = "Tarif recommandé : 1.500 - 3.500 FCFA/heure (vous fixez le montant)";
                    break;
                case 'premium':
                    hourlyRateInput.value = '';
                    hourlyRateInput.disabled = false;
                    hourlyRateInput.required = true;
                    hourlyRateGroup.style.display = 'block';
                    hourlyRateInput.placeholder = "Ex: 5000";
                    rateInfo.textContent = "Tarif recommandé : 4.000 - 10.000 FCFA/heure (vous fixez le montant)";
                    break;
            }
        }

        // Filtrage des services
        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                // Retirer active de tous les boutons
                filterBtns.forEach(b => b.classList.remove('active'));
                
                // Ajouter active au bouton cliqué
                btn.classList.add('active');
                
                // Filtrer les cartes
                const filter = btn.dataset.filter;
                
                serviceCards.forEach(card => {
                    if (filter === 'all' || card.dataset.plan === filter) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });

        // Gestion du formulaire
        document.getElementById('createServiceForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Validation
            if (!selectedPlanInput.value) {
                alert('Veuillez sélectionner une formule de service');
                return;
            }
            
            // Validation du tarif pour les plans payants
            const planType = selectedPlanInput.value;
            const hourlyRate = parseFloat(hourlyRateInput.value);
            
            if (planType !== 'gratuit') {
                if (!hourlyRate || hourlyRate <= 0) {
                    alert('Veuillez saisir un tarif horaire valide');
                    return;
                }
                
                // Validation des plages de tarif recommandées
                if (planType === 'standard' && (hourlyRate < 500 || hourlyRate > 10000)) {
                    if (!confirm(`Le tarif de ${hourlyRate} FCFA/heure est en dehors de la plage recommandée (1.500 - 3.500 FCFA). Voulez-vous continuer ?`)) {
                        return;
                    }
                }
                
                if (planType === 'premium' && (hourlyRate < 1000 || hourlyRate > 20000)) {
                    if (!confirm(`Le tarif de ${hourlyRate} FCFA/heure est en dehors de la plage recommandée (4.000 - 10.000 FCFA). Voulez-vous continuer ?`)) {
                        return;
                    }
                }
            }
            
            // Récupérer les données du formulaire
            const formData = new FormData(this);
            const serviceData = {
                plan_type: formData.get('plan_type'),
                subject: formData.get('subject'),
                level: formData.get('level'),
                title: formData.get('title'),
                description: formData.get('description'),
                hourly_rate: planType === 'gratuit' ? 0 : formData.get('hourly_rate'),
                duration: formData.get('duration'),
                sessions_per_week: formData.get('sessions_per_week')
            };
            
            // Afficher un message de succès
            alert(`Service "${serviceData.title}" créé avec succès ! Il sera visible après validation.`);
            
            // Simuler l'ajout du service (dans une vraie app, on enverrait au serveur)
            console.log('Nouveau service créé:', serviceData);
            
            // Fermer le modal
            closeServiceModal();
        });

        // Initialiser les notifications
        function initNotifications() {
            const notificationList = document.getElementById('notificationList');
            notificationList.innerHTML = '';
            
            notifications.forEach(notification => {
                const notificationItem = document.createElement('div');
                notificationItem.className = `notification-item ${notification.read ? '' : 'unread'}`;
                notificationItem.innerHTML = `
                    <div class="notification-content">
                        <div class="notification-icon ${notification.type}">
                            <i class="fas fa-${getNotificationIcon(notification.type)}"></i>
                        </div>
                        <div class="notification-text">
                            <h4>${notification.title}</h4>
                            <p>${notification.message}</p>
                            <div class="notification-time">${notification.time}</div>
                        </div>
                    </div>
                `;
                
                notificationItem.addEventListener('click', () => {
                    // Marquer comme lu
                    notification.read = true;
                    updateNotificationBadge();
                    initNotifications();
                });
                
                notificationList.appendChild(notificationItem);
            });
        }

        function getNotificationIcon(type) {
            switch(type) {
                case 'success': return 'check-circle';
                case 'warning': return 'exclamation-triangle';
                case 'info': return 'info-circle';
                case 'alert': return 'bell';
                default: return 'bell';
            }
        }

        // Marquer toutes les notifications comme lues
        markAllReadBtn.addEventListener('click', () => {
            notifications.forEach(notification => {
                notification.read = true;
            });
            updateNotificationBadge();
            initNotifications();
        });

        // Mettre à jour le badge de notification
        function updateNotificationBadge() {
            const unreadCount = notifications.filter(n => !n.read).length;
            const badge = document.querySelector('.notification-badge');
            if (badge) {
                badge.textContent = unreadCount;
                if (unreadCount === 0) {
                    badge.style.display = 'none';
                } else {
                    badge.style.display = 'flex';
                }
            }
            
            // Mettre à jour le badge du menu mobile
            const mobileBadge = document.querySelector('.mobile-nav-badge');
            if (mobileBadge) {
                mobileBadge.textContent = unreadCount;
                if (unreadCount === 0) {
                    mobileBadge.style.display = 'none';
                } else {
                    mobileBadge.style.display = 'inline-block';
                }
            }
        }

        // Gestion barre de recherche
        searchFiltersBtn.addEventListener('click', () => {
            searchFiltersPanel.classList.toggle('active');
        });

        closeFiltersBtn.addEventListener('click', () => {
            searchFiltersPanel.classList.remove('active');
        });

