        .btn-service-edit {
            background-color: var(--gris-moyen);
            color: var(--blanc-principal);
        }

        .btn-service-edit:hover {
            background-color: var(--gris-fonce);
            transform: translateY(-2px);
        }

        .btn-service-delete {
            background-color: var(--rouge-principal);
            color: var(--blanc-principal);
        }

        .btn-service-delete:hover {
            background-color: #d32f2f;
            transform: translateY(-2px);
        }

        /* Supprimé: .service-card-stats (nombre d'élèves et séances) */

        /* Nouvelle section: Mes élèves, mes contrats, calendrier */
