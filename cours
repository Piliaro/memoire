        // Éléments DOM
        const mainSearchInput = document.getElementById('mainSearchInput');
        const searchBtn = document.getElementById('searchBtn');
        const searchFiltersBtn = document.getElementById('searchFiltersBtn');
        const searchFiltersPanel = document.getElementById('searchFiltersPanel');
        const closeFiltersBtn = document.getElementById('closeFiltersBtn');
        const sciencesGrid = document.getElementById('sciencesGrid');
        const litteratureGrid = document.getElementById('litteratureGrid');
        const sortSelect = document.getElementById('sortSelect');
        const viewBtns = document.querySelectorAll('.view-btn');
        const resetFiltersBtn = document.getElementById('resetFiltersBtn');
        const applyFiltersBtn = document.getElementById('applyFiltersBtn');

        // Filtres de recherche
        const searchLevel = document.getElementById('searchLevel');
        const searchSubject = document.getElementById('searchSubject');
        const searchType = document.getElementById('searchType');
        const searchPrice = document.getElementById('searchPrice');
        const searchRating = document.getElementById('searchRating');

        // Variables d'état
        let currentView = 'grid';
        let filteredSciences = [];
        let filteredLitterature = [];
        let activeDetailCard = null;

        // Initialisation
        document.addEventListener('DOMContentLoaded', () => {
            filterAndRenderCourses();
            setupSearchFilters();
        });

        // Filtrer et afficher les cours
        function filterAndRenderCourses() {
            const searchTerm = mainSearchInput.value.toLowerCase();
            const selectedLevel = searchLevel.value;
            const selectedSubject = searchSubject.value;
            const selectedType = searchType.value;
            const selectedPrice = searchPrice.value;
            const selectedRating = parseFloat(searchRating.value);
            
            // Filtrer les cours de sciences
            filteredSciences = coursesData.filter(course => {
                if (course.category !== 'sciences') return false;
                return applyFilters(course, searchTerm, selectedLevel, selectedSubject, selectedType, selectedPrice, selectedRating);
            });
            
            // Filtrer les cours de littérature
            filteredLitterature = coursesData.filter(course => {
                if (course.category !== 'litterature') return false;
                return applyFilters(course, searchTerm, selectedLevel, selectedSubject, selectedType, selectedPrice, selectedRating);
            });
            
            // Trier les cours
            sortCourses();
            
            // Afficher les cours
            renderCoursesByCategory();
        }

        // Appliquer les filtres à un cours
        function applyFilters(course, searchTerm, selectedLevel, selectedSubject, selectedType, selectedPrice, selectedRating) {
            // Filtre de recherche
            if (searchTerm && !course.title.toLowerCase().includes(searchTerm) && 
                !course.teacher.toLowerCase().includes(searchTerm) &&
                !getSubjectName(course.subject).toLowerCase().includes(searchTerm)) {
                return false;
            }
            
            // Filtre par niveau
            if (selectedLevel !== 'all' && course.level !== selectedLevel) {
                return false;
            }
            
            // Filtre par matière
            if (selectedSubject !== 'all' && course.subject !== selectedSubject) {
                return false;
            }
            
            // Filtre par type
            if (selectedType !== 'all' && course.type !== selectedType) {
                return false;
            }
            
            // Filtre par prix
            if (selectedPrice !== 'all') {
                if (selectedPrice === 'free' && !course.isFree) return false;
                if (selectedPrice !== 'free' && course.price > parseInt(selectedPrice)) return false;
            }
            
            // Filtre par note
            if (selectedRating > 0 && course.rating < selectedRating) {
                return false;
            }
            
            return true;
        }

        // Afficher les cours par catégorie
        function renderCoursesByCategory() {
            // Afficher les cours de sciences
            sciencesGrid.innerHTML = '';
            const sciencesToShow = filteredSciences.slice(0, 10);
            
            if (sciencesToShow.length === 0) {
                sciencesGrid.innerHTML = `
                    <div style="grid-column: 1 / -1; text-align: center; padding: 20px; color: var(--gris-moyen);">
                        <i class="fas fa-flask" style="font-size: 2rem; margin-bottom: 10px;"></i>
                        <p>Aucun cours de sciences trouvé avec ces critères.</p>
                    </div>
                `;
            } else {
                sciencesToShow.forEach(course => {
                    const courseCard = createCourseCard(course);
                    sciencesGrid.appendChild(courseCard);
                });
            }
            
            // Afficher les cours de littérature
            litteratureGrid.innerHTML = '';
            const litteratureToShow = filteredLitterature.slice(0, 10);
            
            if (litteratureToShow.length === 0) {
                litteratureGrid.innerHTML = `
                    <div style="grid-column: 1 / -1; text-align: center; padding: 20px; color: var(--gris-moyen);">
                        <i class="fas fa-book-open" style="font-size: 2rem; margin-bottom: 10px;"></i>
                        <p>Aucun cours de littérature trouvé avec ces critères.</p>
                    </div>
                `;
            } else {
                litteratureToShow.forEach(course => {
                    const courseCard = createCourseCard(course);
                    litteratureGrid.appendChild(courseCard);
                });
            }
        }

        // Créer une carte de cours avec carte détaillée à côté
        function createCourseCard(course) {
            // Conteneur pour la carte normale et la carte détaillée
            const cardContainer = document.createElement('div');
            cardContainer.style.position = 'relative';
            cardContainer.style.gridColumn = 'span 1';
            
            // Créer la carte normale
            const card = document.createElement('div');
            card.className = `course-card ${course.isPremium ? 'premium' : ''}`;
            card.dataset.courseId = course.id;
            
            // Déterminer le badge
            let badgeHTML = '';
            if (course.isPremium) {
                badgeHTML = '<div class="course-badge badge-premium">PREMIUM</div>';
            } else if (course.isFree) {
                badgeHTML = '<div class="course-badge badge-gratuit">GRATUIT</div>';
            } else {
                badgeHTML = '<div class="course-badge badge-standard">STANDARD</div>';
            }
            
            // Formater le prix
            let priceHTML = '';
            if (course.isFree) {
                priceHTML = `
                    <div class="price-amount price-free">Gratuit</div>
                    <div class="price-period">/cours</div>
                `;
            } else {
                priceHTML = `
                    <div class="price-amount">${course.price.toLocaleString()} FCFA</div>
                    <div class="price-period">/heure</div>
                `;
            }
            
            // Étoiles de notation
            const stars = Math.floor(course.rating);
            const hasHalfStar = course.rating % 1 >= 0.5;
            let starsHTML = '';
            for (let i = 0; i < stars; i++) {
                starsHTML += '<i class="fas fa-star"></i>';
            }
            if (hasHalfStar) {
                starsHTML += '<i class="fas fa-star-half-alt"></i>';
            }
            
            card.innerHTML = `
                <div class="course-header">
                    ${badgeHTML}
                    <div class="course-level">${course.level}</div>
                    <h3 class="course-title">${course.title}</h3>
                    <p class="course-subject">${getSubjectName(course.subject)}</p>
                    
                    <div class="course-teacher">
                        <div class="teacher-avatar">${course.teacherInitials}</div>
                        <div class="teacher-info">
                            <h4>${course.teacher}</h4>
                            <p>${course.profession}</p>
                        </div>
                    </div>
                    
                    <div class="course-location">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>${course.location}</span>
                    </div>
                    
                    <div class="course-meta">
                        <div class="course-rating">
                            ${starsHTML} ${course.rating}/5
                        </div>
                        <div>${course.students} élèves</div>
                    </div>
                    <div class="course-price">
                        ${priceHTML}
                    </div>
                </div>
            `;
            
            // Créer la carte détaillée
            const detailCard = createDetailCard(course);
            detailCard.style.display = 'none';
            
            // Ajouter les cartes au conteneur
            cardContainer.appendChild(card);
            cardContainer.appendChild(detailCard);
            
            // Gestion des événements
            card.addEventListener('mouseenter', () => {
                if (activeDetailCard && activeDetailCard !== detailCard) {
                    activeDetailCard.style.display = 'none';
                }
                detailCard.style.display = 'block';
                activeDetailCard = detailCard;
            });
            
            card.addEventListener('mouseleave', () => {
                // Délai pour éviter la disparition trop rapide
                setTimeout(() => {
                    if (!detailCard.matches(':hover')) {
                        detailCard.style.display = 'none';
                        if (activeDetailCard === detailCard) {
                            activeDetailCard = null;
                        }
                    }
                }, 100);
            });
            
            detailCard.addEventListener('mouseenter', () => {
                detailCard.style.display = 'block';
                activeDetailCard = detailCard;
            });
            
            detailCard.addEventListener('mouseleave', () => {
                detailCard.style.display = 'none';
                if (activeDetailCard === detailCard) {
                    activeDetailCard = null;
                }
            });
            
            // Cliquer sur la carte normale pour voir les détails complets
            card.addEventListener('click', () => {
                viewCourseDetails(course.id);
            });
            
            return cardContainer;
        }

        // Créer la carte détaillée
        function createDetailCard(course) {
            const detailCard = document.createElement('div');
            detailCard.className = 'course-detail-card';
            
            // Déterminer l'offre
            let offerClass = '';
            let offerText = '';
            
            if (course.isPremium) {
                offerClass = 'offer-premium';
                offerText = 'Offre Premium';
            } else if (course.isFree) {
                offerClass = 'offer-free';
                offerText = 'Offre Gratuite';
            } else {
                offerClass = 'offer-standard';
                offerText = 'Offre Standard';
            }
            
            // Objectifs HTML
            const objectivesHTML = course.objectives.map(obj => `<li>${obj}</li>`).join('');
            
            detailCard.innerHTML = `
                <div class="detail-header">
                    <div class="detail-offer ${offerClass}">${offerText}</div>
                    <h3 class="detail-title">${course.title}</h3>
                    <div class="detail-date">
                        <i class="far fa-calendar-alt"></i>
                        Mis à jour le ${course.updatedDate}
                    </div>
                </div>
                <p class="detail-description">${course.description}</p>
                <ul class="detail-objectives">
                    ${objectivesHTML}
                </ul>
                <button class="detail-enroll-btn" onclick="event.stopPropagation(); enrollCourse(${course.id})">
                    <i class="fas fa-user-plus"></i> S'inscrire au cours
                </button>
            `;
            
            return detailCard;
        }

        // Obtenir le nom de la matière
        function getSubjectName(subject) {
            const subjects = {
                'math': 'Mathématiques',
                'french': 'Français',
                'english': 'Anglais',
                'physics': 'Sciences Physiques',
                'svt': 'SVT',
                'history': 'Histoire-Géographie',
                'philo': 'Philosophie',
                'other': 'Autre matière'
            };
            return subjects[subject] || subject;
        }

        // Trier les cours
        function sortCourses() {
            const sortValue = sortSelect.value;
            
            const sortFunction = (a, b) => {
                switch (sortValue) {
                    case 'popular':
                        return b.students - a.students;
                    case 'rating':
                        return b.rating - a.rating;
                    case 'newest':
                        return (b.isNew ? 1 : 0) - (a.isNew ? 1 : 0);
                    case 'price-low':
                        return a.price - b.price;
                    case 'price-high':
                        return b.price - a.price;
                    default:
                        return b.students - a.students;
                }
            };
            
            filteredSciences.sort(sortFunction);
            filteredLitterature.sort(sortFunction);
        }

        // Configuration des filtres de recherche
        function setupSearchFilters() {
            // Ouvrir/fermer les filtres
            searchFiltersBtn.addEventListener('click', () => {
                searchFiltersPanel.classList.toggle('active');
            });

            closeFiltersBtn.addEventListener('click', () => {
                searchFiltersPanel.classList.remove('active');
            });

            // Fermer les filtres en cliquant à l'extérieur
            document.addEventListener('click', (e) => {
                if (!searchFiltersPanel.contains(e.target) && 
                    !searchFiltersBtn.contains(e.target) && 
                    searchFiltersPanel.classList.contains('active')) {
                    searchFiltersPanel.classList.remove('active');
                }
            });

            // Réinitialiser les filtres
            resetFiltersBtn.addEventListener('click', () => {
                searchLevel.value = 'all';
                searchSubject.value = 'all';
                searchType.value = 'all';
                searchPrice.value = 'all';
                searchRating.value = '0';
                mainSearchInput.value = '';
                filterAndRenderCourses();
                searchFiltersPanel.classList.remove('active');
            });

            // Appliquer les filtres
            applyFiltersBtn.addEventListener('click', () => {
                filterAndRenderCourses();
                searchFiltersPanel.classList.remove('active');
            });

            // Recherche avec le bouton de recherche
            searchBtn.addEventListener('click', () => {
                filterAndRenderCourses();
                searchFiltersPanel.classList.remove('active');
            });

            // Recherche avec la touche Entrée
            mainSearchInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    filterAndRenderCourses();
                    searchFiltersPanel.classList.remove('active');
                }
            });

            // Trier les cours
            sortSelect.addEventListener('change', () => {
                sortCourses();
                renderCoursesByCategory();
            });

            // Changer la vue
            viewBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    viewBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    currentView = btn.dataset.view;
                    const grids = document.querySelectorAll('.courses-grid-container');
                    grids.forEach(grid => {
                        grid.className = currentView === 'list' ? 'courses-grid-container list-view' : 'courses-grid-container';
                    });
                });
            });
        }

        // Fonctions pour les boutons des cours
        window.viewCourseDetails = function(courseId) {
            const course = coursesData.find(c => c.id === courseId);
            if (course) {
                // Simulation de redirection vers la page de détails
                alert(`Redirection vers les détails complets du cours:\n\n"${course.title}"\n\nDans une application réelle, vous seriez redirigé vers:\n/course-details.html?id=${course.id}`);
                
                // Code pour une redirection réelle (décommenter pour utiliser) :
                // window.location.href = `course_details.html?id=${courseId}`;
            }
        };

        window.enrollCourse = function(courseId) {
            const course = coursesData.find(c => c.id === courseId);
            if (course) {
                event.stopPropagation(); // Empêcher la propagation du clic
                if (course.isFree) {
                    if (confirm(`Voulez-vous vous inscrire gratuitement au cours "${course.title}" ?`)) {
                        alert('Inscription réussie ! Vous pouvez maintenant accéder au cours.');
                        // Dans une application réelle, appeler l'API d'inscription
                    }
                } else {
                    if (confirm(`Voulez-vous vous inscrire au cours "${course.title}" pour ${course.price.toLocaleString()} FCFA/heure ?`)) {
                        alert('Redirection vers le paiement...');
                        // Dans une application réelle, rediriger vers la page de paiement
                    }
                }
            }
        };
    </script>
